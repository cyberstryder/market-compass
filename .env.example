# Local: set COMPASS_LOCAL=true only on your own machine.
COMPASS_LOCAL=true
COMPASS_ROLE=all
DATABASE_URL=sqlite:///./compass.db
COMPASS_PASSWORD=
# Optional; absent secret is generated securely once and stored in PostgreSQL.
SESSION_SECRET=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_FEED=sip
DATABENTO_API_KEY=
MASSIVE_API_KEY=
TRADERMATRIX_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DISCORD_WEBHOOK_URL=
STOCK_SYMBOLS=SPY,QQQ,IWM,NVDA,AAPL
FUTURES_SYMBOLS=MES.c.0,MNQ.c.0
OPTION_STREAM_CONTRACTS=100
SHADOW_RISK_DOLLARS=100
SHADOW_MAX_DAILY_LOSS=300

# Cumulative ceiling for bounded previous-session futures history recovery.
FUTURES_HISTORY_BUDGET_USD=0.10
