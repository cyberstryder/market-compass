# Market Compass — environment template
# Regenerated 2026-10-21 from the env surface the code actually reads
# (compass/**/*.py + archive_worker.py): every variable the runtime
# looks up, with its code default. Secrets and webhook URLs are left
# empty — set real values only in the deployment environment, never here.

# --- Core runtime ---
# Local only: set true only on your own machine.
COMPASS_LOCAL=true
COMPASS_ROLE=all
# Production uses the Railway Postgres URL.
DATABASE_URL=sqlite:///compass.db
COMPASS_PASSWORD=  # secret
# Optional; absent secret is generated securely once and stored in PostgreSQL.
SESSION_SECRET=  # secret
# Bearer token guarding the state-mutating cron/agent endpoints (audit #3).
COMPASS_CRON_TOKEN=  # secret
# 0 = no storage budget cap.
STORAGE_BUDGET_GB=0
DASHBOARD_CUTOFF_DAY=2026-09-30

# --- Market-data providers ---
APCA_API_KEY_ID=  # secret
APCA_API_SECRET_KEY=  # secret
APCA_API_BASE_URL=https://api.alpaca.markets
ALPACA_FEED=sip
ALPACA_PAPER=true
# Dedicated OPRA stream keys; fall back to the main Alpaca keys when unset.
APCA_OPRA_KEY_ID=  # secret
APCA_OPRA_SECRET_KEY=  # secret
ALPACA_OPTION_STREAM_ENABLED=false
DATABENTO_API_KEY=  # secret
MASSIVE_API_KEY=  # secret
MASSIVE_OPTION_STREAM_CONTRACTS=500
TRADERMATRIX_API_KEY=  # secret
FMP_API_KEY=  # secret

# --- Universes and symbol lists ---
STOCK_SYMBOLS=SPY,QQQ,IWM,NVDA,AAPL
# Quotes/bars only for the day board sector feed; never traded or scanned.
SECTOR_ETF_SYMBOLS=XLK,XLF,XLE,XLV,XLY,XLP,XLI,XLB,XLU,XLRE,XLC
# On all three services: FUTURES_SYMBOLS=ES.c.0,NQ.c.0,MES.c.0,MNQ.c.0
FUTURES_SYMBOLS=MES.c.0,MNQ.c.0
# Each optional exchange stream verifies live entitlement independently. SIL/SI were removed: Tradeify does not support SIL.
EXTRA_FUTURES_SYMBOLS=MGC.v.0,GC.v.0,MCL.v.0,CL.v.0,YM.v.0,MYM.v.0
# Empty uses the saved 144-symbol list in production.
WATCH_SYMBOLS=
DISCOVERY_SEED_SYMBOLS=PONY,FLY,ENPH,AAOI,DAL,S,TTWO,RIG,CARR,PGEN,SDGR,EWTX,ASX
ICT_SYMBOLS=MNQ.c.0,MES.c.0,MGC.v.0,MCL.v.0,MYM.c.0,M2K.c.0,M6A.c.0,M6E.c.0
ICT_SMT_PAIRS=MNQ.c.0:MES.c.0
GAP_LARGE_CAP_SYMBOLS=

# --- Option streams, options trading, and option ideas ---
OPTION_STREAM_CONTRACTS=500
# A count, not a symbol list.
OPTION_FOCUS_SYMBOLS=16
OPTION_CHAIN_MAX_DTE=90
OPTION_QUOTE_MAX_AGE=60
OPTION_MAX_SPREAD_PCT=0.12
OPTION_ENTRY_CUTOFF_MIN=5
OPTION_FLATTEN_MIN=5
OPTION_0DTE_MAX_DTE=7
ZERO_DTE_PAPER_ENABLED=true
OPTION_IDEAS_ENABLED=true
OPTION_IDEAS_ALERTS=true
OPTION_IDEAS_MIN_DTE=1
OPTION_IDEAS_MAX_DTE=21
OPTION_IDEAS_TARGET_DTE=7

# --- Morning, ORB, and SPY brief ---
MORNING_ORB_ENABLED=true
ORB_SETUPS_ENABLED=true
# Native morning program options leg.
OPTIONS_ENABLED=false
SPY_MORNING_BRIEF_ENABLED=false
SPY_CHART_DISCORD_ENABLED=true
SPY_TIMEFRAMES_ENABLED=false
SPY_BRIEF_REFERENCE_PROBE=

# --- Paper trading and setup study ---
# Research is the default. Enable only after a separate strategy promotion decision.
PAPER_TRADING_ENABLED=false
STOCK_PAPER_TRADES=false
SHADOW_RISK_DOLLARS=100
# Zero removes the portfolio entry cap; setup trials are always independent.
SHADOW_MAX_ENTRIES=0
SETUP_STUDY_ENABLED=true
TRAP_PAPER_ENABLED=false

# --- Scanner, research feeds, and discovery ---
# Continuous scanner (no broker execution).
SCANNER_ENABLED=true
SCANNER_PAPER_TRADES=true
RESEARCH_FEEDS_ENABLED=true
DISCOVERY_RESEARCH_ENABLED=false
DISCOVERY_DYNAMIC_LIMIT=50

# --- Flow, magnets, and intraday feature flags ---
FLOW_PULSE_ENABLED=true
FLOW_PULSE_MIN_PREMIUM=1000000
FLOW_PULSE_MIN_SCORE=90
FLOW_PULSE_MIN_RATIO=2.0
FLOW_PULSE_MAX_DTE=45
FLOW_PULSE_PUSH_ENABLED=false
FLOW_PULSE_TRACK_ENABLED=true
APEX_MAGNET_ENABLED=true
APEX_MAGNET_RADIUS=0.02
APEX_MAGNET_TOLERANCE=0.001
MAGNET_PUSH_ENABLED=false
MAGNET_PUSH_SIGNALS=broke_through
SQUEEZE_ENABLED=true
DARKPOOL_ENABLED=true
BREAKOUTS_ENABLED=true
TAPE_CONFIRMED_ENABLED=true
IV_RANK_ENABLED=true
GAP_CONTINUATION_ENABLED=true
GAP_PUSH_ENABLED=true
GAP_MIN_GAP=0.015
DAY_TRADING_BOARD_ENABLED=true
DAY_BOARD_PUSH_ENABLED=true
FUTURES_SCANNER_PUSH_ENABLED=false
MU_SCALP_ENABLED=true

# --- Swing ideas ---
SWING_IDEAS_ENABLED=true
SWING_IDEAS_ALERTS=true
SWING_MIN_DTE=14
SWING_MAX_DTE=60
SWING_TARGET_DTE=30
SWING_MAX_HOLD_SESSIONS=10

# --- ICT futures paper trading and detectors ---
# Live book (2026-10-24 prune, MES added 2026-10-25): AOI Fade {MCL, MES}
# and Turtle Soup {MCL} mirror to TradersPost; Golden Zone {MCL, MNQ} and
# Rumers Box {MYM} are paper-only. The pruned detectors (bos_fvg,
# bos_gz_vwap, aoi_zones, smt_divergence) default OFF in code and hold
# empty symbol allowlists — the false values below match those defaults.
ICT_FUTURES_PAPER_ENABLED=true
ICT_PAPER_COOLDOWN_MIN=15
ICT_PAPER_MIN_STOP_ATR=0.5
ICT_PUSH_ENABLED=false
ICT_BRAKE_SHADOW_ENABLED=true
FRESHNESS_GUARD_ENABLED=true
ICT_SESSION_LIQUIDITY_ENABLED=true
ICT_HTF_LEVELS_ENABLED=true
ICT_HTF_TRADINGVIEW=false
ICT_TV_CACHE_DIR=
ICT_TURTLE_SOUP_ENABLED=true
ICT_SMT_DIVERGENCE_ENABLED=false
ICT_AOI_ZONES_ENABLED=false
ICT_AOI_FADE_ENABLED=true
ICT_TREND_RIDER_ENABLED=false
ICT_GOLDEN_ZONE_ENABLED=true
ICT_TIER_A_B_ENABLED=false
ICT_GZ_EMA_FAST=9
ICT_GZ_EMA_SLOW=21
ICT_GZ_EMA_CROSS_LOOKBACK=5
ICT_GZ_EMA_CROSS_ENABLED=false
ICT_BOS_FVG_ENABLED=false
ICT_BOS_GZ_VWAP_ENABLED=false
ICT_RUMERS_BOX_ENABLED=true
ICT_TREND_BIAS_ENABLED=false
ICT_TREND_BIAS_SMA_LEN=50
VIX_REGIME_ENABLED=true
VIX_LOW_THRESHOLD=15.0
VIX_HIGH_THRESHOLD=25.0
GAP_FADE_ENABLED=false
GAP_FADE_MIN_PCT=0.005
GAP_FADE_MAX_PCT=0.02
GAP_FADE_TARGET_PCT=0.5
VWAP_FADE_ENABLED=true
VWAP_FADE_SD_ENTRY=2.0
VWAP_FADE_SD_STOP=3.0
VWAP_FADE_SESSION=ny
# Cumulative ceiling for bounded previous-session futures history recovery.
FUTURES_HISTORY_BUDGET_USD=0.10

# --- Discord webhooks ---
# Default/fallback channel webhook.
DISCORD_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_SPY_MORNING_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_OPTIONS_0DTE_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_INTRADAY_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_MAGNETS_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_OPTIONS_IDEAS_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_SMOOTHERS_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_FUTURES_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_RESEARCH_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_FLOW_PULSE_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_ICT_WEBHOOK_URL=  # webhook URL (secret)
DISCORD_SHARED_FALLBACK=true

# --- Native program senders (Discord) ---
NATIVE_PROGRAM_SEND_ENABLED=false
NATIVE_MORNING_RELAY_ENABLED=true
NATIVE_MORNING_DISCORD_WEBHOOK=  # webhook URL (secret)
NATIVE_MORNING_DISCORD_WEBHOOK_SECONDARY=  # webhook URL (secret)
NATIVE_SMOOTHERS_DISCORD_WEBHOOK=  # webhook URL (secret)
NATIVE_SMOOTHERS_DISCORD_WEBHOOK_SECONDARY=  # webhook URL (secret)
NATIVE_SMOOTHERS_SHARED_DISCORD_WEBHOOK=  # webhook URL (secret)

# --- Integrations and execution bridges ---
MORNING_SOURCE_URL=
MORNING_INTEGRATION_TOKEN=  # secret
NATIVE_MORNING_INTAKE_TOKEN=  # secret
SMOOTHERS_SOURCE_URL=
SMOOTHERS_INTEGRATION_TOKEN=  # secret
FUTURES_OBSERVER_STREAMS=
FUTURES_OBSERVER_TOKEN=  # secret
OBSIDIAN_FEED_URL=
TRADERSPOST_ENABLED=false
TRADERSPOST_WEBHOOK_URL=  # webhook URL (secret)
# Second prop-firm webhook.
TRADERSPOST_WEBHOOK_URL_2=  # webhook URL (secret)
CROSSTRADE_ENABLED=false
CROSSTRADE_WEBHOOK_URL=  # webhook URL (secret)
CROSSTRADE_KEY=  # secret
CROSSTRADE_ACCOUNT=

# --- Secondary review ---
SECONDARY_REVIEW_ENABLED=true
SECONDARY_REVIEW_ALERTS=true
SECONDARY_REVIEW_COMPASS_FUTURES=true

# --- Archive and prune (R2 object storage) ---
# Set to "scheduled" on the archive service.
ARCHIVE_MODE=
ARCHIVE_BUCKET=
ARCHIVE_ENDPOINT=
ARCHIVE_REGION=auto
ARCHIVE_ADDRESSING_STYLE=virtual
ARCHIVE_ACCESS_KEY_ID=  # secret
ARCHIVE_SECRET_ACCESS_KEY=  # secret
ARCHIVE_MAX_ROWS=10000
ARCHIVE_AFTER_ID=0
PRUNE_DELETE_SUB_BATCH=5000
PRUNE_DELETE_PROBE=50000
PRUNE_DELETE_CALL_SECONDS=40
PRUNE_VERIFY_INLINE_SECONDS=120
